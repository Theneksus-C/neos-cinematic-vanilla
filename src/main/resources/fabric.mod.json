{
	"schemaVersion": 1,
	"id": "neoscinematicvanilla",
	"version": "${version}",
	"name": "Neo's Cinematic Vanilla",
	"description": "Makes the vanilla world feel like a place: fog that responds to altitude, caves, weather and the hour, motes drifting on a shared wind, biomes with their own character, and optional film grain. Client side only. Gameplay and world generation are unchanged.",
	"authors": [
		"Theneksus-C"
	],
	"license": "MIT",
	"contact": {
		"homepage": "https://github.com/Theneksus-C/neos-cinematic-vanilla",
		"sources": "https://github.com/Theneksus-C/neos-cinematic-vanilla",
		"issues": "https://github.com/Theneksus-C/neos-cinematic-vanilla/issues"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.theneksusc.neoscinematicvanilla.NeosCinematicVanillaClient"
		]
	},
	"mixins": [
		{
			"config": "neoscinematicvanilla.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
